# Required - Discord bot token
BOT_TOKEN=

# Optional - Spotify integration
# Spotify app client ID (without it, Spotify links are read from public pages only)
SPOTIFY_CLIENT_ID=
# Spotify app client secret
SPOTIFY_CLIENT_SECRET=

# Optional - Last.fm autoplay recommendations
# Last.fm API key
LASTFM_API_KEY=
# Last.fm API secret
LASTFM_API_SECRET=

# Optional - LRCLIB requires an identifiable User-Agent for lyrics requests.
LRCLIB_USER_AGENT=DiscordMusicBot/1.0 (https://github.com/Tons-7/Discord-Music-Bot)
# LRCLIB app ID from lrclib.net/developers, for higher rate limits
# LRCLIB_APP_ID=
# LRCLIB API key that goes with LRCLIB_APP_ID
# LRCLIB_API_KEY=

# Optional - Discord Activity (Embedded App)
# OAuth client ID of the Discord application
DISCORD_CLIENT_ID=
# OAuth client secret of the Discord application
DISCORD_CLIENT_SECRET=
# Signs Activity sessions (default DISCORD_CLIENT_SECRET); generate: python -c "import secrets;print(secrets.token_hex(32))"
# ACTIVITY_SECRET=
# Port of the Activity/API server
# ACTIVITY_PORT=8080

# Optional - playback (defaults shown; leave commented out to keep them)
# Songs longer than this many seconds stream without being cached (0 = cache every length)
# AUDIO_CACHE_MAX_DURATION=1200
# Seconds discord.py gets to finish its own voice reconnect before the bot rejoins
# VOICE_RECONNECT_TIMEOUT=45
# Pause when nobody is left in the voice channel, and leave after this many seconds (0 = never)
# ALONE_TIMEOUT_SECONDS=180
# Show the playing song as the voice channel status (0 = off)
# VOICE_CHANNEL_STATUS=1
# Most songs read from one playlist or set link
# MAX_COLLECTION_ENTRIES=500
# Most songs one queue holds
# MAX_QUEUE_SIZE=1000
# Netscape cookies.txt for yt-dlp (throwaway account) if YouTube asks to confirm you're not a bot
# YTDLP_COOKIES=/path/to/cookies.txt

# Optional - storage, logging and shutdown (defaults shown)
# SQLite database file; Docker Compose always uses /data/music_bot.db
# DB_PATH=music_bot.db
# Directory for daily database backups (unset = no backups)
# DB_BACKUP_DIR=backups
# Number of daily backups to keep
# DB_BACKUP_KEEP=7
# Delete listening stats older than this many days (0 = keep forever)
# STATS_RETENTION_DAYS=0
# Log level for yt-dlp's own messages
# YTDLP_LOG_LEVEL=WARNING
# Seconds to wait for open Activity audio streams before shutting down
# GRACEFUL_SHUTDOWN_TIMEOUT=5

# Docker Compose only
# Cloudflare Tunnel token; point the tunnel's public hostname at http://bot:8080
CLOUDFLARE_TUNNEL_TOKEN=
# Host address the API port is published on (0.0.0.0 = every interface)
# ACTIVITY_PUBLISH_IP=127.0.0.1
